<h1 class="index-user-header">Список пользователей</h1>
<div class="index-user-container">
  <% @users.each do |user|%>

    <div class="index-user-card">
      <div class="index-user-<%=user.role%>">
        <h3 class="index-user-username"><%= user.email %></h3>
        <div class="role">(<%= user.role %>)</div>
      </div>

      <% unless (user.member? || user == current_user)%>
        <div class="make-member"><%= button_to "Назначить участником", make_member_path(user), method: :patch%></div>
      <% end %>
      <% unless (user.admin? ||user == current_user)%>
        <div class="make-admin"><%= button_to "Назначить админом", make_admin_path(user), method: :patch%></div>
      <% end %>
    </div>
  <%end%>
</div>