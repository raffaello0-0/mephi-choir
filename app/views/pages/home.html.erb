<div class="container">
  <div class="calendar-frame">
    <%= image_tag "frame.png", alt: "Рамка"%>
  </div>
  <div class="container-content">
    <div class="left">
      <div class="calendar" data-event-dates="<%= @event_dates.to_json %>">
        <div class="month">
          <%# <i class="fa fa-angle-left prev"></i> %>
          <div class="prev"> &laquo; </div>
          <div class="date"></div>
          <%# <i class="fa fa-angle-right next"></i> %>
          <div class="next"> &raquo; </div>
    
        </div>
        <div class="weekdays">
          <div>Пн</div>
          <div>Вт</div>
          <div>Ср</div>
          <div>Чт</div>
          <div>Пт</div>
          <div>Сб</div>
          <div>Вс</div>
        </div>
        <div class="days">

        </div>
        <div class="goto-today">
          <div class="goto">
            <input type="text" placeholder="мм.гггг" class="date-input">
            <button class="goto-btn">Перейти</button>
          </div>
          <button class="today-btn">Сегодня</button>
        </div>
      </div>
    </div>
    <div class="right">
      <div class="today-date">
        <div class="event-day"></div>
        <div class="event-date"></div>
      </div>
      <div class="events">

      </div>
      <div class="add-event">
        <div class="hidden-add-event">Создать мероприятие</div>
        <button class="add-event-btn">
          <p class="plus">+</p>
        </button>
      </div>
    </div>
  </div>
</div>






<div class="announcements">
  <h1>Недавние объявления </h1>
  <% if @recent_announcements.any? %>
    <% @recent_announcements.each do |announcement| %>
      <div class="announcement_card" style="border: 1px solid #ccc; padding: 10px; margin-bottom: 10px;">
          <h2> <%= announcement.title %> </h2>
          <p><%= simple_format(announcement.content)%></p>
          <p><%= announcement.created_at.strftime("%Y-%d-%m %H:%M:%S") %></p>
      </div>
    <% end %>
    <%= link_to "Посмотреть все объявления", announcements_path%>
  <% else %>
    <p> Список объявлений пуст</p>
  <% end %>
  
  <div>
      <img src="#" alt="ТУТ КАРТИНКА!!! Хор НИЯУ МИФИ">
  </div>
</div>

























