</div>








<div class="calendar-block">
  <div class="calendar-frame">
    <%= image_tag "search.png", alt: "Рамка"%>
  </div>

  <div class="calendar-row"> 
    <div class="calendar-arrow">
      <%= image_tag "arrow.png", alt: "Стрелка"%>
    </div>

    <div class="container">

      <div class="container-content">
        <div class="left">
          <div class="calendar" data-event-dates="<%= @event_dates.to_json %>">
            <div class="month">
              <%# <i class="fa fa-angle-left prev"></i> %>
              <div class="prev"> &laquo; </div>
              <div class="date"></div>
              <%# <i class="fa fa-angle-right next"></i> %>
              <div class="next"> &raquo; </div>
        
            </div>
            <div class="weekdays">
              <div>Пн</div>
              <div>Вт</div>
              <div>Ср</div>
              <div>Чт</div>
              <div>Пт</div>
              <div>Сб</div>
              <div>Вс</div>
            </div>
            <div class="days">

            </div>
            <div class="goto-today">
              <div class="goto">
                <input type="text" placeholder="мм.гггг" class="date-input">
                <button class="goto-btn">Перейти</button>
              </div>
              <button class="today-btn">Сегодня</button>
            </div>
          </div>
        </div>
        <div class="right">
          <div class="today-date">
            <div class="event-day"></div>
            <div class="event-date"></div>
          </div>
          <div class="events">

          </div>
          <div class="add-event">
            <div class="hidden-add-event">Создать мероприятие</div>
            <button class="add-event-btn">
              <p class="plus">+</p>
            </button>
          </div>
        </div>
      </div>
    </div>

    <div class="calendar-arrow-copy">
      <%= image_tag "arrow(copy).png", alt: "Микрофон"%>
    </div>
  </div>
</div>





<div class="announcements">
  <h1 class="announcement-header">Недавние объявления </h1>
  
  <div class="clips">
    <div class="clip">
        <%= image_tag "clip.png", alt: "Скрепка1"%>
    </div>
      <div class="clip">
        <%= image_tag "clip.png", alt: "Скрепка2"%>
    </div>
  </div>
  <div class="megaphone">
    <%= image_tag "megaphone2.png", alt: "Мегафон"%>
  </div>
  <div class="announcement-container">
    <% if @recent_announcements.any? %>
      <% @recent_announcements.each do |announcement| %>
        <div class="announcement-card">
            <h2 class="announcement-title"> <%= announcement.title %> </h2>
            <div class="announcement-content"><%= simple_format(announcement.content)%></div>
            <div class="announcement-created-at"><%= announcement.created_at.strftime("%d.%m.%Y %H:%M:%S") %></div>
            <div class="announcement-show"> <%= link_to "Показать", announcement_path(announcement.id)%></div>
        </div>
      <% end %>
      <div class="announcement-index"><%= link_to "Посмотреть все объявления", announcements_path%></div>
    <% else %>
      <div class="no-announcements"> Список объявлений пуст</div>
    <% end %>
  </div>
</div>

























