<h1 class="index-announcement-header">
  <span class="orange">Объявления</span>
  академического хора НИЯУ МИФИ
</h1>
<div class="index-announcement-clips">
  <div class="index-announcement-clip">
      <%= image_tag "clip.png", alt: "Скрепка1"%>
  </div>
    <div class="index-announcement-clip">
      <%= image_tag "clip.png", alt: "Скрепка2"%>
  </div>
</div>
<div class="index-announcement-megaphone">
  <%= image_tag "megaphone2.png", alt: "Мегафон"%>
</div>
<div class="index-announcement-container">
  <% if @announcements.any? %>
    <% @announcements.each do |announcement| %>
      <div class="index-announcement-card">
        <h2 class="index-announcement-title"> <%= announcement.title %> </h2>
        <div class="index-announcement-content"><%= simple_format(announcement.content)%></div>
        <div class="index-announcement-created-at"><%= announcement.created_at.strftime("%Y-%d-%m %H:%M:%S") %></div>
        <div class="index-announcement-show"><%= link_to "Показать", announcement_path(announcement.id) %></div>
      </div>
    <% end %>
  <% else %>
    <div class="index-no-announcements"> Список объявлений пуст</div>
  <% end %>
</div>