<%= form_with model: @announcement do |form| %>
  <% if @announcement.errors.any?  %>
    <div class="new-edit-announcement-errors">
      <h2> Возникли ошибки при отправке формы </h2>
      <ul>
        <% @announcement.errors.full_messages.each do |m| %>
          <li> <%= m %> </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="new-edit-form">
    <h1 class="new-edit-announcement-header"> Новое объявление </h1>
    <div class="new-edit-announcement-title">
      <%= form.label :title, "Название (обязательно)" %>
      <%= form.text_field :title %>
    </div>

    <div class="new-edit-announcement-content">
      <%= form.label :content, "Содержание (обязательно)" %>
      <%= form.text_area :content %>
    </div>

    <div class="new-edit-announcement-submit"> 
      <%= form.submit "Сохранить" %>
    </div>
  </div>
<%end%>
