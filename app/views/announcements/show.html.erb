<div style="border: 1px solid #ccc; padding: 10px; margin-bottom: 10px;">
        <h2> <%= @announcement.title %> </h2>
        <p><%= simple_format(@announcement.content)%></p>
        <p><%= @announcement.created_at.strftime("%Y-%d-%m %H:%M:%S")  %></p>
</div>

<div>
  <%= link_to "Редактировать", edit_announcement_path(@announcement) %>
  <%= button_to "Удалить", @announcement, method: :delete, data: {turbo_confirm: "Вы уверены, что хотите удалить объявление?"} %>
  <%= link_to "К списку объявлений", announcements_path %>
</div>