 <div class="show-announcement-block">
  <div class="show-announcement-container">
    <div class="show-announcement-card">
      <h2 class="show-announcement-title"> <%= @announcement.title %> </h2>
      <div class="show-announcement-content"><%= simple_format(@announcement.content)%></div>
      <div class="show-announcement-created-at"><%= @announcement.created_at.strftime("%d.%m.%Y %H:%M:%S")  %></div>
    </div>
  </div>
</div>

