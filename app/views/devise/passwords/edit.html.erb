<div class="change-password-container">
<h2 class="change-password-header">Change your password</h2>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <%= f.hidden_field :reset_password_token %>

  <div class="change-password-password">
    <p><%= f.label :password, "New password" %></p>
    <% if @minimum_password_length %>
      <p><em>(<%= @minimum_password_length %> characters minimum)</em></p>
    <% end %>
    <div><%= f.password_field :password, autofocus: true, autocomplete: "new-password" %></div>
  </div>

  <div class="change-password-password">
    <p><%= f.label :password_confirmation, "Confirm new password" %></p>
    <div><%= f.password_field :password_confirmation, autocomplete: "new-password" %></div>
  </div>

  <div  class="change-password-submit">
    <%= f.submit "Change my password" %>
  </div>
<% end %>

<%= render "devise/shared/links" %>
