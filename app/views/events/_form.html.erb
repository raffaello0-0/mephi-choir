<%= form_with model: @event do |form| %>
  <% if @event.errors.any?  %>
    <h2> Возникли ошибки при отправке формы </h2>
    <ul>
      <% @event.errors.full_messages.each do |m| %>
        <li> <%= m %> </li>
      <% end %>
    </ul>
  <% end %>


  <%= form.label :title, "Название" %>
  <%= form.text_field :title %>

  <%= form.label :event_type, "Тип мероприятия" %>
  <%= form.select :event_type, [['Участие в конкурсе', 'competition'], ['Концерт', 'concert'], ['Репетиция', 'repetition']] %> 

  <%= form.label :event_date, "Дата" %>
  <%= form.date_field :event_date %>

  <%= form.label :start_time, "Время начала" %>
  <%= form.time_field :start_time %>

  <%= form.label :location, "Место проведения" %>
  <%= form.text_field :location %>

  <%= form.label :description, "Описание" %>
  <%= form.text_area :description %>

  <div> 
  <%= form.submit "Сохранить" %>
  </div>
<%end%>

