<div class="show-event-block">
  <div class="show-event-container">
    <div class="show-event-card">
      <h2 class="show-event-title"> <%= @event.title %> </h2>
      <div class="show-event-type"> Тип: <%= @event.event_type_ru %> </div>
      <div class="show-event-date"> Дата: <%= @event.event_date %> </div>
      <div class="show-event-time"> Время: <%= @event.start_time.strftime("%H:%M")%> </div>
      <div class="show-event-location"> Место: <%= @event.location %> </div>
      <div class="show-event-description"><%= simple_format(@event.description) %> </div>
    </div>
  </div>
</div>
