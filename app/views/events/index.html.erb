<h1 class="index-event-header">
  Расписание
  <span class="red">мероприятий</span>
     академического хора НИЯУ МИФИ
</h1>
<div class="index-clips">
  <div class="index-clip">
      <%= image_tag "clip.png", alt: "Скрепка1"%>
  </div>
    <div class="clip">
      <%= image_tag "clip.png", alt: "Скрепка2"%>
  </div>
</div>
<div class="index-event-container">
<% if @events.any? %>
  <% @events.each do |event| %>
    <div class="index-event-card">
        <h2 class="index-event-title"> <%= event.title %> </h2>
        <div class="index-event-type"> Тип: <%= event.event_type_ru %> </div>
        <div class="index-event-date"> Дата: <%= event.event_date.strftime('%d.%m.%Y') %> </div>
        <div class="index-event-time"> Время: <%= event.start_time.strftime("%H:%M") %> </div>
        <div class="index-event-location"> Место: <%= event.location %> </div>
        <div class="index-event-description"> <%= simple_format(event.description) %> </div>
        <div class="index-event-show"><%= link_to "Показать", event_path(event.id) %></div>
    </div>
  <% end %>
<% else %>
  <div class="index-no-events"> Список мероприятий пуст</p>
<% end %>


